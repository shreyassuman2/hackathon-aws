# Copy to .env and fill in. Everything has a working default for local dev:
# no AWS, no LLM, messages print to the console, negotiations use canned vendor replies.

# ── Founder ───────────────────────────────────────────────
RUNWAY_FOUNDER_PHONE=            # +15551234567. Empty = every inbound message is treated as the founder
RUNWAY_FOUNDER_NAME=             # used to sign negotiation emails
RUNWAY_FOUNDER_TZ_OFFSET=-7      # hours from UTC, for business-hours gating

# ── API ───────────────────────────────────────────────────
RUNWAY_API_TOKEN=                # set this whenever the API is reachable from outside your laptop

# ── Storage: local | dynamodb ─────────────────────────────
RUNWAY_STORE=local
RUNWAY_LOCAL_STORE_PATH=.data/runway.json
RUNWAY_DYNAMODB_TABLE=runway
# RUNWAY_DYNAMODB_ENDPOINT=http://localhost:8001   # DynamoDB Local

# ── AWS ───────────────────────────────────────────────────
RUNWAY_AWS_REGION=us-east-1
# Standard AWS credentials (AWS_PROFILE, or AWS_ACCESS_KEY_ID/...) are picked up automatically.

# ── LLM: off | bedrock ────────────────────────────────────
RUNWAY_LLM=off
RUNWAY_MODEL_FAST=anthropic.claude-haiku-5-5
RUNWAY_MODEL_SMART=anthropic.claude-sonnet-5-5
# If your account doesn't have access to those yet, these are open to every Bedrock account:
# RUNWAY_MODEL_FAST=anthropic.claude-haiku-4-5
# RUNWAY_MODEL_SMART=anthropic.claude-sonnet-5

# ── Messaging: console | imessage ─────────────────────────
RUNWAY_NOTIFIER=console
RUNWAY_IMESSAGE_BRIDGE_URL=http://127.0.0.1:3099

# ── Negotiation email: demo | live ────────────────────────
RUNWAY_MAIL=demo
RUNWAY_EMAIL_FROM=               # SES-verified sender (live mode)
RUNWAY_IMAP_HOST=imap.gmail.com  # inbox Runway reads vendor replies from (live mode)
RUNWAY_IMAP_USER=
RUNWAY_IMAP_PASSWORD=            # Gmail app password, not your real password
RUNWAY_NEGOTIATION_POLL_SECONDS=10

# ── iMessage bridge (bridge/) ─────────────────────────────
RUNWAY_API_URL=http://127.0.0.1:8000
BRIDGE_ALLOWED_SENDERS=          # comma-separated numbers the bridge forwards
